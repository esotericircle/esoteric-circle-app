{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "compileOnSave": true,
  "include": ["src"],
  // LE PROVE DELLE REGOLE RESTANO FUORI DA QUESTA COMPILAZIONE.
  //
  // `regole.emulatore.ts` importa `@firebase/rules-unit-testing` e il client
  // `firebase`: sono strumenti di prova, non fanno parte delle funzioni, e il
  // server che le costruisce non li installa. Lasciandolo qui, `npm run build`
  // cadrebbe su un tipo mancante proprio nel predeploy del deploy. Si compila da
  // se' con `tsconfig.regole.json`, che `npm run test:regole` usa.
  "exclude": ["src/regole.emulatore.ts"]
}
