# QUESTO PODFILE E' VERSIONATO APPOSTA, e non e' quello che genera Flutter.
#
# La terza build su Codemagic e' caduta in pod install con due segnali:
# CocoaPods avvisava "Automatically assigning platform iOS with version 15.0
# on target Runner because no platform was specified", e subito dopo
# google_mlkit_commons pretendeva un minimo piu' alto. Senza questo file la
# piattaforma la decideva CocoaPods da solo, copiandola dal progetto Xcode:
# adesso il numero vive qui, esplicito e leggibile.
#
# QUINDICI E MEZZO E' UNA MISURA, non una scelta: e' il massimo dei minimi
# dichiarati nei podspec di tutti i 20 plugin iOS del progetto, e lo impongono
# google_mlkit_commons 0.11.1 e google_mlkit_face_detection 0.13.2. Lo stesso
# numero sta in IPHONEOS_DEPLOYMENT_TARGET dentro project.pbxproj, e la prova
# il_target_ios_e_il_massimo_dei_plugin_test.dart rifa' la misura a ogni giro
# della suite: se un plugin nuovo pretende di piu', cade lei prima che il pod
# install lo scopra su un Mac a pagamento.
platform :ios, '15.5'

# CocoaPods manda statistiche in rete in modo sincrono e rallenta la build.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
