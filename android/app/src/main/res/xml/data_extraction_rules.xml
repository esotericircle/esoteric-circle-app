<?xml version="1.0" encoding="utf-8"?>
<!--
  Regole per Android 12 e successivi, sia per il backup su cloud sia per il
  trasferimento diretto fra due telefoni.

  Stessa scelta delle regole precedenti: fuori il file delle preferenze, che
  contiene la fotografia del volto, la data e il luogo di nascita. Il resto
  dell'app non ha nulla da portarsi dietro.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
